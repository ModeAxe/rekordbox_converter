{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DrokerBox USB Converter",
  "version": "0.1.0",
  "identifier": "dev.modea.rekordbox-usb-converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
    "app": {
    "windows": [
      {
        "title": "DrokerBox USB Converter",
        "width": 380,
        "height": 540,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
